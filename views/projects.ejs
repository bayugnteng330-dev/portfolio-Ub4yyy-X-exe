<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Projects — Arvexta</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <!-- ==================================================
         PAGE LOADER
    ================================================== -->

    <div id="page-loader">

        <div class="loader-content">

            <div class="loader-logo">
                Ub4yyy<span> X exe </span>
            </div>

            <div class="loader-line"></div>

            <div class="loader-text">
                Loading experience...
            </div>

        </div>

    </div>


    <!-- ==================================================
         NAVBAR
    ================================================== -->

    <nav class="navbar">

        <div class="logo">
            ARV<span>EXTA</span>
        </div>

        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/about">
                About
            </a>

            <a href="/projects">
                Projects
            </a>

            <a href="/contact">
                Contact
            </a>

        </div>

    </nav>


    <!-- ==================================================
         PROJECTS
    ================================================== -->

    <main class="projects-page">

        <section class="page-header">

            <span>
                02 / PROJECTS
            </span>

            <h1>
                My <span>Projects</span>
            </h1>

            <p class="page-description">
                Koleksi project yang saya bangun
                menggunakan berbagai teknologi web
                dan software development.
            </p>

        </section>


        <section class="section">

            <% if (projects && projects.length > 0) { %>

                <div class="project-grid">

                    <% projects.forEach((project, index) => { %>

                        <article class="project-card">


                            <!-- PROJECT IMAGE -->

                            <div class="project-image">

                                <% if (project.image) { %>

                                    <img
                                        src="<%= project.image %>"
                                        alt="<%= project.title %>"
                                    >

                                <% } else { %>

                                    <div class="project-placeholder">

                                        <span>
                                            ARVEXTA
                                        </span>

                                        <small>
                                            PROJECT_<%= String(index + 1).padStart(2, "0") %>
                                        </small>

                                    </div>

                                <% } %>


                                <div class="project-overlay">

                                    <span>
                                        PROJECT_<%= String(index + 1).padStart(2, "0") %>
                                    </span>

                                </div>

                            </div>


                            <!-- PROJECT CONTENT -->

                            <div class="project-content">


                                <div class="project-number">

                                    PROJECT_<%= String(index + 1).padStart(2, "0") %>

                                </div>


                                <h2>

                                    <%= project.title %>

                                </h2>


                                <p>

                                    <%= project.description %>

                                </p>


                                <!-- TECHNOLOGY -->

                                <% if (project.tech) { %>

                                    <div class="tech">

                                        <% project.tech
                                            .split(",")
                                            .forEach(item => { %>

                                            <span>

                                                <%= item.trim() %>

                                            </span>

                                        <% }); %>

                                    </div>

                                <% } %>


                                <!-- ACTIONS -->

                                <div class="project-actions">


                                    <% if (project.github) { %>

                                        <a
                                            href="<%= project.github %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >

                                            GitHub

                                            <span>
                                                ↗
                                            </span>

                                        </a>

                                    <% } %>


                                    <% if (project.demo) { %>

                                        <a
                                            href="<%= project.demo %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >

                                            Live Demo

                                            <span>
                                                ↗
                                            </span>

                                        </a>

                                    <% } %>


                                    <!-- VIEW DETAILS -->

                                    <a
                                        href="/projects/<%= project.id %>"
                                        class="project-link"
                                    >

                                        View Details →

                                    </a>


                                </div>

                            </div>

                        </article>

                    <% }); %>

                </div>


            <% } else { %>


                <!-- EMPTY PROJECT -->

                <div class="empty-project">

                    <div class="empty-icon">
                        01
                    </div>

                    <h2>
                        No Projects Yet
                    </h2>

                    <p>
                        Project sedang dalam proses
                        pengembangan.
                    </p>

                </div>


            <% } %>

        </section>

    </main>


    <!-- ==================================================
         FOOTER
    ================================================== -->

    <footer>

        <div>
            © 2026 
        </div>

        <div>
            Node.js + Express + EJS + MySQL
        </div>

    </footer>


    <!-- ==================================================
         JAVASCRIPT
    ================================================== -->

    <script src="/js/script.js"></script>

    <script src="/js/loading.js"></script>


</body>

</html>