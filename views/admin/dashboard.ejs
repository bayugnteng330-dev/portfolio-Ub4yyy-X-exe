<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Dashboard — ARVEXTA</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body class="admin-dashboard">

    <nav class="admin-navbar">

        <a
            href="/admin"
            class="logo"
        >
            ARV<span>EXTA</span>
        </a>

        <div class="admin-nav-right">

            <span>
                Admin: <strong><%= admin.username %></strong>
            </span>

            <a href="/admin/logout">
                Logout
            </a>

        </div>

    </nav>


    <main class="admin-container">

        <div class="admin-heading">

            <div>

                <span class="admin-label">
                    ADMIN PANEL
                </span>

                <h1>
                    Dashboard
                </h1>

                <p>
                    Kelola portfolio ARVEXTA dari sini.
                </p>

            </div>

        </div>


        <div class="admin-stats">

            <div class="admin-stat-card">

                <span>
                    TOTAL PROJECT
                </span>

                <strong>
                    <%= projects.length %>
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>
                    SYSTEM
                </span>

                <strong>
                    MVC
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>
                    DATABASE
                </span>

                <strong>
                    MYSQL
                </strong>

            </div>

        </div>


        <section class="admin-section">

            <div class="admin-section-header">

                <div>

                    <span class="admin-label">
                        PROJECT MANAGEMENT
                    </span>

                    <h2>
                        Projects
                    </h2>

                </div>

                <a
                    href="/admin/projects/create"
                    class="admin-button"
                >
                    + Add Project
                </a>

            </div>


            <div class="admin-project-list">

                <% if (projects.length === 0) { %>

                    <div class="admin-empty">
                        Belum ada project.
                    </div>

                <% } %>


                <% projects.forEach((project, index) => { %>

                    <article class="admin-project">

                        <div class="admin-project-number">
                            <%= String(index + 1).padStart(2, "0") %>
                        </div>


                        <div class="admin-project-info">

                            <h3>
                                <%= project.title %>
                            </h3>

                            <p>
                                <%= project.description %>
                            </p>

                            <div class="tech">

                                <% if (project.tech) { %>

                                    <% project.tech
                                        .split(",")
                                        .forEach(item => { %>

                                        <span>
                                            <%= item.trim() %>
                                        </span>

                                    <% }); %>

                                <% } %>

                            </div>

                        </div>


                        <div class="admin-project-actions">

                            <a
                                href="/projects/<%= project.id %>"
                                target="_blank"
                            >
                                View
                            </a>

                            <a
                                href="/admin/projects/edit/<%= project.id %>"
                            >
                                Edit
                            </a>

                            <form
                                action="/admin/projects/delete/<%= project.id %>"
                                method="POST"
                                onsubmit="return confirm('Hapus project ini?')"
                            >

                                <button type="submit">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </article>

                <% }); %>

            </div>

        </section>

    </main>

</body>

</html>