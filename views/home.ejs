<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Bayu Samudra — Full Stack Developer</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


<!-- ==================================================
     PAGE LOADER
     JANGAN DIUBAH
================================================== -->

<div id="page-loader">

    <div class="loader-content">

        <div class="loader-logo">
            Ub4yyy<span> X exe</span>
        </div>

        <div class="loader-line"></div>

        <div class="loader-text">
            Loading experience...
        </div>

    </div>

</div>


<!-- ==================================================
     NAVBAR
================================================== -->

<nav class="navbar">

    <a href="/" class="logo">
        Ub4yyy<span> X exe</span>
    </a>


    <div class="nav-links">

        <a href="/" class="active">
            Home
        </a>

        <a href="/about">
            About
        </a>

        <a href="/projects">
            Projects
        </a>

        <a href="/contact">
            Contact
        </a>

    </div>

</nav>


<!-- ==================================================
     HERO
================================================== -->

<main>

<section class="home-hero">


    <!-- BACKGROUND -->

    <div class="hero-grid"></div>


    <!-- ================= LEFT ================= -->

    <div class="hero-content">


        <!-- STATUS -->

        <div class="hero-status">

            <span class="status-dot"></span>

            AVAILABLE FOR PROJECTS

        </div>


        <!-- HELLO -->

        <p class="hero-small">
            HELLO, I'M
        </p>


        <!-- NAME -->

        <h1 class="hero-title">

            <span class="name-white">
                Bayu
            </span>

            <span class="name-purple">
                Samudra
            </span>

        </h1>


        <!-- ROLE -->

        <h2 class="hero-role">
            Full Stack Developer
        </h2>


        <!-- DESCRIPTION -->

        <p class="hero-description">

            Saya membangun website dan aplikasi
            modern dengan fokus pada performa,
            desain, dan pengalaman pengguna.

        </p>


        <!-- BUTTON -->

        <div class="hero-buttons">

            <a
                href="/projects"
                class="btn primary"
            >
                View Projects
                <span>→</span>
            </a>


            <a
                href="/contact"
                class="btn secondary"
            >
                Contact Me
            </a>

        </div>


        <!-- TECHNOLOGY -->

        <div class="hero-tech">

            <span>NODE.JS</span>

            <span>EXPRESS</span>

            <span>EJS</span>

            <span>MYSQL</span>

            <span>JAVASCRIPT</span>

            <span>PHP</span>

            <span>LARAVEL</span>

            <span>TYPESCRIPT</span>

        </div>

    </div>


    <!-- ================= RIGHT ================= -->

    <div class="hero-card">


        <!-- ORBIT -->

        <div class="orbit orbit-one"></div>

        <div class="orbit orbit-two"></div>


        <!-- PHOTO -->

        <div class="avatar">

            <img
                src="/images/ubay.jpeg"
                alt="Bayu Samudra"
            >

        </div>


        <!-- DEVELOPER BADGE -->

        <div class="developer-badge">

            <div class="code-icon">
                &lt;/&gt;
            </div>

            <span>
                Full Stack
                <br>
                Developer
            </span>

        </div>


        <!-- DOTS -->

        <div class="decorative-dots">

            <span></span>

            <span></span>

            <span></span>

            <span></span>

        </div>


        <!-- BUILDING -->

        <div class="building-label">

            // BUILDING

            <br>

            BETTER WEB

        </div>


    </div>

</section>


<!-- ==================================================
     INTRO
================================================== -->

<section class="home-intro">

    <div class="intro-number">
        01
    </div>

    <div>

        <p class="intro-label">
            WHAT I DO
        </p>

        <h2>

            Turning ideas into

            <span>
                digital experiences.
            </span>

        </h2>

    </div>

</section>

</main>


<!-- ==================================================
     FOOTER
================================================== -->

<footer>

    <div>
        © 2026 
    </div>

    <div>
        Node.js + Express + EJS + MySQL
    </div>

</footer>


<!-- ==================================================
     JAVASCRIPT
================================================== -->

<script src="/js/script.js"></script>

<!-- LOADING TETAP -->
<script src="/js/loading.js"></script>

